package gui;

import mc.fenix.basic.GemText;
import mc.fenix.basic.GemButton;
import mc.fenix.arrange.GemColumn;
import mc.fenix.arrange.GemRow;
import mc.fenix.arrange.GemCard;
import mc.fenix.arrange.GemGrid;
import mc.fenix.input.GemRangeInput;

import gui.navigation.NavContainer;

import FactoryDigitalTwin.Station;
import FactoryDigitalTwin.Alarm;
import FactoryDigitalTwin.Prognosis;
import FactoryDigitalTwin.Signal;

page Start(List<Station> stations, List<Signal> signals, ?boolean detailOpen = false, ?int selectedStationId) {
  @NavContainer(content = [
    @GemColumn(rowGap = "24px", width = "100%", components = [
      @GemColumn(rowGap = "2px", components = [
        @GemText(value = "Dashboard", size = "2rem", weight = "bold"),
        @GemText(value = "Live overview", color = "secondary")
      ]),
      @GemRow(colGap = "16px", components = [
        stationsCard@GemCard(
          title = "Stations",
          component = @GemColumn(rowGap = "4px", components = [
            stationsValue@GemText(value = getStationCount(), size = "2.2rem", weight = "bold")
          ])
        ),
        signalsCard@GemCard(
          title = "Signals",
          component = @GemColumn(rowGap = "4px", components = [
            signalsValue@GemText(value = getSignalCount(), size = "2.2rem", weight = "bold")
          ])
        ),
        healthCard@GemCard(
          title = "Avg station Health",
          component = @GemColumn(rowGap = "4px", components = [
            healthValue@GemText(value = getSystemHealth(), size = "2.2rem", weight = "bold")
          ])
        ),
        alarmsCard@GemCard(
          title = "open alarms",
          component = @GemColumn(rowGap = "4px", components = [
            alarmsValue@GemText(value = getTotalAlarmCount(), size = "2.2rem", weight = "bold"),
            @GemText(value = "require attention", color = "secondary")
          ])
        )
      ]),
      @GemRow(colGap = "16px", components = [
        @GemColumn(rowGap = "16px", width = "65%", components = [
          factoryCard@GemCard(
            title = "Factory Layout",
            component = @GemColumn(rowGap = "16px", components = [

              @GemText(value = "click a station for details", color = "secondary"),
              stationGrid@GemRow(wrap = "wrap", colGap = "14px", rowGap = "14px", components = [
                @iterate(Station station : stations) {
                  @guard(station.isExecuting){
                    activeTile@GemCard(
                      component = @GemColumn(rowGap = "8px", components = [
                        @GemText(value = station.name, weight = "bold"),
                        @GemRow(colGap = "8px", components = [
                            @GemText(value = "State: "),
                            @GemText(value = getStationStateText(station), weight = "bold")
                        ]),
                        @GemRow(colGap = "8px", components = [
                            @GemText(value = "Health"),
                            @GemText(value = station.currentHealth, weight = "bold")
                        ]),
                        @GemRow(colGap = "8px", components = [
                            @GemText(value="Cycles: "),
                            @GemText(value = station.cycleCount)
                        ]),
                        @guard(hasActiveAlarm(station)){
                            @GemText(value = "Active Alarm", color = "#dc2626", weight = "bold");
                        },
                        @GemColumn(height = "6px", components = []),
                        @GemButton(
                            label = "Select",
                            leftClick = selectStation(station)
                        )
                      ])
                    );
                  }
                  @guard(isNotExecuting(station)){
                    stationTile@GemCard(
                      component = @GemColumn(rowGap = "8px", components = [
                        @GemText(value = station.name, weight = "bold"),
                        @GemRow(colGap = "8px", components = [
                            @GemText(value = "State: "),
                            @GemText(value = getStationStateText(station), weight = "bold")
                        ]),
                        @GemRow(colGap = "8px", components = [
                            @GemText(value = "Health"),
                            @GemText(value = station.currentHealth, weight = "bold")
                        ]),
                        @GemRow(colGap = "8px", components = [
                            @GemText(value="Cycles: "),
                            @GemText(value = station.cycleCount)
                        ]),
                        @guard(hasActiveAlarm(station)){
                            @GemText(value = "Active Alarm", color = "#dc2626", weight = "bold");
                        },
                        @GemColumn(height = "6px", components = []),
                        @GemButton(
                            label = "Select",
                            leftClick = selectStation(station)
                        )
                      ])
                    );
                  }
                }
              ])
            ])
          ),
          @guard(detailOpen) {
            selectedPanel@GemCard(
              title = "selected station",
              component = @GemColumn(rowGap = "12px", components = [
                @iterate(Station station:stations){
                    @guard(isSelectedStation(station)){
                        detailContent@GemColumn(rowGap = "12px", components = [
                            @GemGrid(rows = [
                              [@GemText(value = "name: "), @GemText(value = station.name, weight = "bold")],
                              [@GemText(value = "machine iD: "), @GemText(value = station.machineId, weight = "bold")],
                              [@GemText(value = "state: "), selectedStateLabel@GemText(value = getStationStateText(station))],
                              [@GemText(value = "executing: "), executingLabel@GemText(value = getStationExecutingText(station))],
                              [@GemText(value = "cycles: "), @GemText(value = station.cycleCount, weight = "bold")]
                            ]),
                            @GemColumn(height = "1px", components = []),
                            @GemText(value = "components", weight = "bold"),


                            @GemColumn(rowGap = "4px", components = [
                                @iterate(String line : getComponentLines(station)) {
                                    @guard(isComponentActive(line)){
                                        componentRowActive@GemRow(colGap="8px", components= [
                                            dotActive@GemColumn(width="10px", height = "10px", components=[]),
                                            @GemText(value=getComponentLabel(line)),
                                            @GemText(value=getComponentValue(line), color = "secondary")
                                        ]);
                                    }
                                    @guard(isComponentInactive(line)){
                                        componentRowInActive@GemRow(colGap="8px", components= [
                                            dotInactive@GemColumn(width="10px", height = "10px", components=[]),
                                            @GemText(value=getComponentLabel(line)),
                                            @GemText(value=getComponentValue(line), color = "secondary")
                                        ]);
                                    }
                                }
                            ]),



                            @GemColumn(height = "1px", components = []),
                            @GemText(value = "thermal status", weight = "bold"),
                            @GemGrid(rows = [
                                [@GemText(value = "temperature: "), @GemText(value = getSelectedTemp(station), weight = "bold")],
                                [@GemText(value = "Status: "), thermalLabel@GemText(value = getSelectedThermalStatus(station))]
                            ]),
                            @GemColumn(height = "1px", components = []),
                            @GemText(value = "energy", weight = "bold"),
                            @GemGrid(rows = [
                                [@GemText(value = "current power: "), @GemText(value = getSelectedCurrentPower(station), weight = "bold")],
                                [@GemText(value = "consumed: "), @GemText(value = getSelectedEnergyConsumed(station), weight = "bold")]
                            ]),
                            @GemColumn(height = "1px", components = []),
                            @GemGrid(rows = [
                            [@GemText(value = "health: "), @GemText(value = getSelectedStationHealth(station))],
                            [@GemText(value = "wear index: "), @GemText(value = getSelectedWearIndex(station))],
                            [@GemText(value = "next maintenance: "), @GemText(value = getSelectedNextMaintenance(station))],
                            [@GemText(value = "summary: "), @GemText(value = getSelectedMaintenanceSummary(station))]
                            ]),
                            @GemColumn(height = "1px", components = []),
                            @GemText(value = "latest alarm", weight = "bold"),
                            latestAlarmBox@GemColumn(rowGap = "4px", components = [
                                @GemText(value = getLatestAlarmKind(station)),
                                @GemText(value = getLatestAlarmMessage(station), color = "secondary"),
                                @GemText(value = getLatestAlarmTime(station), color = "secondary")
                            ]),
                            @GemButton(label = "close", leftClick = closeDetail())
                        ]);
                    }
                }
              ])
            );
          }

        ])

      ])

    ])
  ]);
}

